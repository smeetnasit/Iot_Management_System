@{
    ViewData["Title"] = "Sensors Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-primary"><i class="bi bi-cpu"></i> Sensors Management</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSensorModal">
            <i class="bi bi-plus-circle"></i> Add Sensor
        </button>
    </div>

    <table id="sensorTable" class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Sensor ID</th>
                <th>Name</th>
                <th>Type</th>
                <th>Code</th>
                <th>Location</th>
                <th>Unit</th>
                <th>Status</th>
                <th>Last Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- Data will load dynamically -->
        </tbody>
    </table>
</div>

<!-- Add Sensor Modal -->
<div class="modal fade" id="addSensorModal" tabindex="-1" aria-labelledby="addSensorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addSensorModalLabel">Add New Sensor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addSensorForm">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Sensor Name</label>
                            <input type="text" class="form-control" id="SensorName" >
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sensor Code</label>
                            <input type="text" class="form-control" id="SensorCode" >
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Type</label>
                            <select class="form-select" id="SensorType">
                                <option>Temperature</option>
                                <option>Humidity</option>
                                <option>Gas</option>
                                <option>Motion</option>
                                <option>Light</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit</label>
                            <input type="text" class="form-control" id="Unit" placeholder="°C / ppm / lux">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sensor State</label>
                            <input type="text" class="form-control" id="SensorState">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Min Threshold</label>
                            <input type="number" step="any" class="form-control" id="MinThreshold">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Max Threshold</label>
                            <input type="number" step="any" class="form-control" id="MaxThreshold">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">Save Sensor</button>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/dataTables.bootstrap5.min.css" />

    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#sensorTable').DataTable({
                ajax: {
                    url: '/api/Sensor/GetAll',
                    dataSrc: ''
                },
                columns: [
                    { data: 'id' },
                    { data: 'sensorName' },
                    { data: 'sensorType' },
                    { data: 'sensorCode' },
                    { data: 'location' },
                    { data: 'unit' },
                    {
                        data: 'state',
                        render: function (data) {
                            return data == 1
                                ? '<span class="badge bg-success">Active</span>'
                                : '<span class="badge bg-secondary">Inactive</span>';
                        }
                    },
                    { data: 'updatedDate' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `
                                <button class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                            `;
                        }
                    }
                ]
            });

            // Add Sensor
            $('#addSensorForm').submit(function (e) {
                e.preventDefault();

                var formData = {
                    SensorName: $('#SensorName').val(),
                    SensorCode: $('#SensorCode').val(),
                    SensorType: $('#SensorType').val(),
                    Unit: $('#Unit').val(),
                    SensorState: $('#SensorState').val(),
                    MinThreshold: $('#MinThreshold').val(),
                    MaxThreshold: $('#MaxThreshold').val()
                };

                $.ajax({
                    url: '/Home/Add_Sensor',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        console.log('Data saved successfully:', response);

                        // Accept numeric/string 200 or a truthy success flag
                        if (response && (response.code == "200" || response.code == 200 || response.success === true)) {
                            $('#addSensorModal').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: 'Data Saved',
                                text: 'Data saved successfully!',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(function () {
                                table.ajax.reload(null, false); // reload DataTable without resetting paging
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred while saving.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error saving sensor:', {
                            status: status,
                            error: error,
                            responseText: xhr.responseText
                        });

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An error occurred while saving. Please try again later.'
                        });
                    }
                });
            });
        });
    </script>
}

