@{
    ViewData["Title"] = "Alerts";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">
            <i class="bi bi-exclamation-triangle"></i> Alerts
        </h2>
        <small class="text-muted">Last updated: <span id="lastUpdated"></span></small>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Alerts</h6>
                    <h3 class="mb-0 text-danger" id="kpi-total">...</h3>
                    <small class="text-muted">All time</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h6 class="card-title text-muted">New</h6>
                    <h3 class="mb-0 text-danger" id="kpi-new">...</h3>
                    <small class="text-muted">Unattended alerts</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body">
                    <h6 class="card-title text-muted">Acknowledged</h6>
                    <h3 class="mb-0 text-warning" id="kpi-ack">...</h3>
                    <small class="text-muted">Being handled</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h6 class="card-title text-muted">Resolved</h6>
                    <h3 class="mb-0 text-success" id="kpi-resolved">...</h3>
                    <small class="text-muted">Fixed alerts</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">Alert History (Last 100)</h6>
                <button class="btn btn-sm btn-outline-danger" id="refreshBtn">
                    🔄 Refresh
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-danger">
                        <tr>
                            <th>#</th>
                            <th>Sensor</th>
                            <th>Unit</th>
                            <th>Value</th>
                            <th>Min</th>
                            <th>Max</th>
                            <th>Type</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="alertsTableBody">
                        <tr>
                            <td colspan="10" class="text-center">
                                Loading...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getStatusBadge(status) {
            switch (status) {
                case 'New':
                    return '<span class="badge bg-danger">🔴 New</span>';
                case 'Acknowledged':
                    return '<span class="badge bg-warning text-dark">🟡 Acknowledged</span>';
                case 'Resolved':
                    return '<span class="badge bg-success">🟢 Resolved</span>';
                default:
                    return '<span class="badge bg-secondary">Unknown</span>';
            }
        }

        function getActionButtons(readingId, status) {
            if (status === 'New') {
                return `<button class="btn btn-sm btn-warning"
                    onclick="updateStatus(${readingId}, 'Acknowledged')">
                    Acknowledge</button>`;
            } else if (status === 'Acknowledged') {
                return `<button class="btn btn-sm btn-success"
                    onclick="updateStatus(${readingId}, 'Resolved')">
                    Resolve</button>`;
            } else {
                return '<span class="text-muted">—</span>';
            }
        }

        function updateStatus(readingId, newStatus) {
            $.ajax({
                url: `https://app-iot-api-dev-f5fvhxbpagezbrhb.westus2-01.azurewebsites.net/api/Dashboard/alert/${readingId}/status`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ status: newStatus }),
                success: function (data) {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: `Alert ${newStatus}!`,
                        showConfirmButton: false,
                        timer: 2000
                    });
                    // Update just that row
                    $(`#status-${readingId}`)
                        .html(getStatusBadge(newStatus));
                    $(`#action-${readingId}`)
                        .html(getActionButtons(readingId, newStatus));
                    // Update KPIs
                    loadAlerts();
                },
                error: function () {
                    Swal.fire('Error', 'Could not update status', 'error');
                }
            });
        }

        function loadAlerts() {
            $.get('https://app-iot-api-dev-f5fvhxbpagezbrhb.westus2-01.azurewebsites.net/api/Dashboard/alerts',
            function (data) {
                // KPIs
                $('#kpi-total').text(data.length);
                $('#kpi-new').text(
                    data.filter(d => d.alert_Status === 'New').length);
                $('#kpi-ack').text(
                    data.filter(d => d.alert_Status === 'Acknowledged').length);
                $('#kpi-resolved').text(
                    data.filter(d => d.alert_Status === 'Resolved').length);
                $('#lastUpdated').text(
                    new Date().toLocaleTimeString());

                // Table
                let rows = '';
                data.forEach(function (r, index) {
                    const isHigh = r.reading_Value > r.maxThreshold;
                    const typeBadge = isHigh
                        ? '<span class="badge bg-danger">Too High ↑</span>'
                        : '<span class="badge bg-info">Too Low ↓</span>';
                    const time = new Date(r.reading_Time)
                        .toLocaleString();

                    rows += `<tr>
                        <td>${index + 1}</td>
                        <td>${r.sensor_Name}</td>
                        <td>${r.sensor_Unit}</td>
                        <td><strong class="text-danger">
                            ${r.reading_Value}</strong></td>
                        <td>${r.minThreshold}</td>
                        <td>${r.maxThreshold}</td>
                        <td>${typeBadge}</td>
                        <td>${time}</td>
                        <td id="status-${r.reading_Id}">
                            ${getStatusBadge(r.alert_Status)}</td>
                        <td id="action-${r.reading_Id}">
                            ${getActionButtons(r.reading_Id, r.alert_Status)}
                        </td>
                    </tr>`;
                });
                $('#alertsTableBody').html(rows);
            });
        }

        $(document).ready(function () {
            loadAlerts();
            setInterval(loadAlerts, 30000);
            $('#refreshBtn').click(function () {
                loadAlerts();
            });
        });
    </script>
}